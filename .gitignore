# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — ignore ALL dotenv files so secrets are never committed, keeping
# only the checked-in template that documents required variables (MN-03). The
# negation must follow the broad pattern for git to re-include the example.
.env*
!.env.example

# secrets / credentials — never commit private keys, certificates, or keystores
# (*.pem is already ignored under "misc" above) (MN-03).
*.key
*.p12
*.pfx
*.jks
*.keystore

# vercel
.vercel

# typescript
*.tsbuildinfo
